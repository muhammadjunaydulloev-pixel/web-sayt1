# Ин файлро нусхабардорӣ карда, номи онро ".env" гузоред ва қиматҳоро пур
# кунед. Файли ".env" ҳаргиз набояд ба git супорида шавад (аллакай дар
# .gitignore ҳаст).

# ---------- AI Assistant ----------
# Провайдер: "groq" (тавсия — ройгон ва тез), "openai", "anthropic" ё "none" (реҷаи демо)
AI_PROVIDER=groq

# Калиди махфии API — ҳаргиз онро дар frontend, git ё ягон ҷои дигари
# намоён нагузоред!
AI_API_KEY=

# Номи модел (ихтиёрӣ). Мисол барои Groq: llama-3.3-70b-versatile
# Мисол барои OpenAI: gpt-4o-mini
# Мисол барои Anthropic: claude-3-5-haiku-20241022
AI_MODEL=

# ---------- Дигар танзимот (аллакай мавҷуданд) ----------
# SECRET_KEY=
# PAYMENT_CARD_NUMBER=
# PAYMENT_CARD_NAME=
# COURSE_PRICE=
